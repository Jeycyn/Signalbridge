# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MAP_TILE_URL: Optional custom raster tile server template URL.
# Defaults to OpenStreetMap standard tiles through server proxy with compliant User-Agent.
# If using a third-party key provider (e.g. Stadia Maps or MapTiler), provide the key here server-side:
# Example: MAP_TILE_URL="https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key=YOUR_STADIA_KEY"
# Obtain free tier keys at https://client.stadiamaps.com or https://cloud.maptiler.com
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
